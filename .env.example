# Shopee partner app (https://open.shopee.com → App List)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Optional per-region overrides (sandbox and China apps usually have their own id/key).
# Regions: GLOBAL, BRAZIL, CHINA, TEST_GLOBAL, TEST_CHINA. A region shows up as
# selectable only when it has credentials (shared or region-specific).
# SHOPEE_PARTNER_ID_TEST_GLOBAL=
# SHOPEE_PARTNER_KEY_TEST_GLOBAL=

# Supabase project (Settings → API). The service role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (Connect → Session pooler). Not needed on Vercel.
# SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Magickids Ads Autopilot (xem AUTOPILOT.md) ---
# Bí mật cho các job route (/api/jobs/*), dùng lại trong supabase/cron.sql.
# JOB_SECRET=
# Khóa mã hóa token Shopee trong DB (chuỗi ngẫu nhiên ≥ 32 ký tự). ĐỪNG đổi sau khi đã mã hóa.
# TOKEN_ENC_KEY=
# Mật khẩu dashboard /admin.
# ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Bí mật webhook Telegram (header X-Telegram-Bot-Api-Secret-Token).
# TELEGRAM_WEBHOOK_SECRET=
# Mặc định true: chỉ ghi log, không gọi API ghi. Chỉ đặt "false" khi đã sẵn sàng.
# AUTOPILOT_DRY_RUN=true
# Hành động chạy thật dù đang dry-run, cách nhau dấu phẩy (vd change_budget).
# AUTOPILOT_LIVE_ACTIONS=
# Pancake POS (chỉ đọc): giá vốn + tồn kho theo biến thể, đồng bộ 01:15 mỗi đêm.
# PANCAKE_API_KEY=
# PANCAKE_SHOP_ID=608127
# AUTOPILOT_SHOPS=92907330:Magickids,971643674:Annie Baby - Váy bé gái

# Public URL of this deployment, used for the Shopee redirect URL.
# Optional: defaults to the Vercel production domain, or the request origin locally.
# APP_URL=https://your-app.vercel.app
