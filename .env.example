# Shopee partner app (https://open.shopee.com → App List)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Optional per-region overrides (sandbox and China apps usually have their own id/key).
# Regions: GLOBAL, BRAZIL, CHINA, TEST_GLOBAL, TEST_CHINA. A region shows up as
# selectable only when it has credentials (shared or region-specific).
# SHOPEE_PARTNER_ID_TEST_GLOBAL=
# SHOPEE_PARTNER_KEY_TEST_GLOBAL=

# Supabase project (Settings → API). The service role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (Connect → Session pooler). Not needed on Vercel.
# SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Public URL of this deployment, used for the Shopee redirect URL.
# Optional: defaults to the Vercel production domain, or the request origin locally.
# APP_URL=https://your-app.vercel.app
